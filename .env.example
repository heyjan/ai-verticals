# Postgres — used by every TS service.
# The default DATABASE_URL points at the compose-managed `postgres`
# service, so it works as-is for `docker compose up`. Override only if
# you point services at an external Postgres.
POSTGRES_USER=jobs
POSTGRES_PASSWORD=jobs
POSTGRES_DB=jobs
POSTGRES_PORT=5432
DATABASE_URL=postgres://jobs:jobs@postgres:5432/jobs

# Dashboard port on the host.
DASHBOARD_PORT=3000

# DeepSeek (used by classifier/src/{classify-jobs,discover-taxonomy,enrich-companies}.ts).
DEEPSEEK_API_KEY=

# Anthropic — used by pi.dev for the long-running interactive agent
# (classifier/src/interactive.ts). Leave blank to disable the agent
# service; other compose services will still come up cleanly.
ANTHROPIC_API_KEY=

# How often the pi.dev agent compacts its context (in turns).
PI_COMPACT_EVERY_TURNS=20
