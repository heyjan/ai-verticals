# Postgres — used by every TS service.
# The default DATABASE_URL points at the compose-managed `postgres`
# service, so it works as-is for `docker compose up`. Override only if
# you point services at an external Postgres.
POSTGRES_USER=jobs
POSTGRES_PASSWORD=jobs
POSTGRES_DB=jobs
POSTGRES_PORT=5432
DATABASE_URL=postgres://jobs:jobs@postgres:5432/jobs

# Dashboard port on the host.
DASHBOARD_PORT=3000

# DeepSeek (used by the classifier scripts and the Data Chat analytics agent).
DEEPSEEK_API_KEY=

# Dedicated SELECT-only Postgres role used by the analytics service.
# Use at least 16 URL-safe characters because this value is embedded in
# CHAT_DATABASE_URL inside Docker Compose.
CHAT_RO_PASSWORD=

# Auth (nuxt-auth-utils). Generate with: openssl rand -base64 32
NUXT_SESSION_PASSWORD=

# Data Chat service URL used by Nuxt outside Docker Compose.
NUXT_ANALYTICS_URL=http://localhost:8000
