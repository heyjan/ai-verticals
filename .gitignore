*.py[cod]
.venv/
scrapers/.venv/

# Node / Nuxt
node_modules/
.nuxt/
.output/
.data/
*.db
# Exception: the committed bootstrap SQLite is the source of truth for fresh deploys.
!data/seed/jobs.db

# Compiled TS
dist/
build/

# Raw scrape data (large, regenerable — kept locally only)
data/raw/

# Processed / intermediate datasets — large and regenerable from the
# scrapers + import pipeline. Kept local only; the seed image
# (data/seed/jobs.db) is the source of truth for fresh deploys.
data/processed/

# Trained model binaries (regenerable via scrapers/.../dedup/train.py).
data/models/

# Generated reports (HTML + screenshots) produced from the live dataset.
reports/

# Old top-level data layout (pre-restructure) — these files were moved
# to scrapers/ artifacts and are not part of the new convention.
data/linkedin_*.json
data/glassdoor_*.json
data/merged_jobs_*.json
data/removed_jobs_*.json

# Playwright artifacts
