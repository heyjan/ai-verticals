# Python
__pycache__/
*.py[cod]
.venv/
scrapers/.venv/

# Node / Nuxt
node_modules/
.nuxt/
.output/
.data/
*.db
# Exception: the committed bootstrap SQLite is the source of truth for fresh deploys.
!data/seed/jobs.db

# Compiled TS
dist/
build/

# Raw scrape data (large, regenerable — kept locally only)
data/raw/

# Processed / intermediate datasets — large and regenerable from the
# scrapers + import pipeline. Kept local only; the seed image
# (data/seed/jobs.db) is the source of truth for fresh deploys.
data/processed/

# Trained model binaries (regenerable via scrapers/.../dedup/train.py).
data/models/

# Generated reports (HTML + screenshots) produced from the live dataset.
reports/

# Loose top-level data dumps (pre-restructure scrape/merge artifacts).
# Anything sitting directly in data/ is a regenerable local dump; the
# curated subdirs (data/seed/ bootstrap) are matched separately above and
# unaffected by these (globs don't cross `/`).
/data/*.json
/data/*.csv

# Playwright artifacts
test-results/
dashboard/test-results/
dashboard/playwright-report/
dashboard/e2e/screenshots/

# Logs
*.log

# Secrets
.env
.env.local

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Local notes / scratch — not part of the repo's public docs.
docs/

# Markdown files are local notes by default; only README.md and AGENTS.md are tracked.
*.md
!README.md
!**/README.md
!AGENTS.md

# Design comps / agent scratch — input material, not part of the app.
.codex/
