DEEPSEEK_API_KEY=your-deepseek-api-key-here
NUXT_ANALYTICS_URL=http://localhost:8000

# --- Auth (nuxt-auth-utils) ---------------------------------------------------
# Seals the session cookie. MUST be >= 32 chars in prod. Generate with:
#   openssl rand -base64 32
NUXT_SESSION_PASSWORD=change-me-to-a-random-string-at-least-32-chars

# OAuth apps. Each provider's callback / redirect URL is `<origin>/auth/<name>`,
# e.g. https://ai-verticals.dev/auth/github (and http://localhost:3000/auth/github in dev).
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=

NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# X (Twitter) OAuth 2.0 app — enable OAuth 2.0 with PKCE.
NUXT_OAUTH_X_CLIENT_ID=
NUXT_OAUTH_X_CLIENT_SECRET=

# LinkedIn — "Sign In with LinkedIn using OpenID Connect" product.
NUXT_OAUTH_LINKEDIN_CLIENT_ID=
NUXT_OAUTH_LINKEDIN_CLIENT_SECRET=

# Optional: force a redirect URL when the server can't infer the public origin
# (e.g. behind Traefik). One per provider:
# NUXT_OAUTH_GITHUB_REDIRECT_URL=https://ai-verticals.dev/auth/github

# --- SMTP (waitlist notifications) -------------------------------------------
# Leave NUXT_SMTP_HOST empty to disable mail: the waitlist endpoint still
# records signups to .data/waitlist.jsonl, it just skips sending.
NUXT_SMTP_HOST=
NUXT_SMTP_PORT=587
# true for implicit TLS (port 465); false for STARTTLS (port 587).
NUXT_SMTP_SECURE=false
NUXT_SMTP_USER=
NUXT_SMTP_PASS=
NUXT_SMTP_FROM=ai-verticals <noreply@ai-verticals.de>
# Recipient for signup notifications (defaults to the Impressum contact).
NUXT_WAITLIST_NOTIFY_TO=jan@heyjan.de
